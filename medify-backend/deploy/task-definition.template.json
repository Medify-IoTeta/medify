{
  "family": "medify-backend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::865394826818:role/LabRole",
  "taskRoleArn": "arn:aws:iam::865394826818:role/LabRole",
  "containerDefinitions": [
    {
      "name": "medify-backend",
      "image": "865394826818.dkr.ecr.us-east-1.amazonaws.com/medify-backend:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "DB_HOST", "value": "medify-db.cdowm82my5o9.us-east-1.rds.amazonaws.com" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_NAME", "value": "medify" },
        { "name": "DB_USERNAME", "value": "medifyadmin" },
        { "name": "DB_PASSWORD", "value": "__DB_PASSWORD__" },
        { "name": "SERVER_PORT", "value": "8080" },
        { "name": "FIREBASE_CREDENTIALS_JSON", "value": "__FIREBASE_CREDENTIALS_JSON__" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/medify-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
