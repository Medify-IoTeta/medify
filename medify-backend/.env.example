# Copy this file to .env and fill in real values. .env is git-ignored.

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=medify
DB_USERNAME=medify_user
DB_PASSWORD=change-me

# --- Backend ---
SERVER_PORT=8080

# --- Firebase Cloud Messaging ---
# Local/Docker: place your service-account JSON at medify-backend/secrets/firebase-service-account.json
# (git-ignored) and leave FIREBASE_CREDENTIALS_JSON empty; docker-compose mounts it automatically.
# Production/AWS: set FIREBASE_CREDENTIALS_JSON to the full service-account JSON content
# (e.g. injected from AWS Secrets Manager) instead of mounting a file.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
